	<library_kinematics_models id="kmodels">
		<kinematics_model id="kmodel0" name="install_lid2">
			<technique_common>
				<joint name="huatai" sid="huatai">
					<prismatic sid="axis0">
						<axis>1 0 0</axis>
						<limits>
							<min>-0.88</min>
							<max>0</max>
						</limits>
					</prismatic>
				</joint>
				<joint name="install_j1" sid="install_j1">
					<prismatic sid="axis0">
						<axis>1 0 0</axis>
						<limits>
							<min>-0.10</min>
							<max>0.20</max>
						</limits>
					</prismatic>
				</joint>
				<joint name="install_j2" sid="install_j2">
					<prismatic sid="axis0">
						<axis>1 0 0</axis>
						<limits>
							<min>-0.04</min>
							<max>0</max>
						</limits>
					</prismatic>
				</joint>
				<joint name="install_j3" sid="install_j3">
					<prismatic sid="axis0">
						<axis>1 0 0</axis>
						<limits>
							<min>-0.04</min>
							<max>0</max>
						</limits>
					</prismatic>
				</joint>
				<joint name="qigang" sid="qigang">
					<revolute sid="axis0">
						<axis>0 0 0</axis>
						<limits>
							<min>0</min>
							<max>0</max>
						</limits>
					</revolute>
				</joint>
				//这个是上料桶结构，固定
				<joint name="tong" sid="tong">
					<revolute sid="axis0">
						<axis>0 0 0</axis>
						<limits>
							<min>0</min>
							<max>0</max>
						</limits>
					</revolute>
				</joint>
				//下面workbase\workbase1\workbase2\workbase3是上盖设备工作平台/不做运动学要求/固定/写出来是为了体现完整的结构
				<joint name="workbase" sid="workbase">
					<revolute sid="axis0">
						<axis>0 0 0</axis>
						<limits>
							<min>0</min>
							<max>0</max>
						</limits>
					</revolute>
				</joint>
				<joint name="workbase1" sid="workbase1">
					<revolute sid="axis0">
						<axis>0 0 0</axis>
						<limits>
							<min>0</min>
							<max>0</max>
						</limits>
					</revolute>
				</joint>
				<joint name="workbase2" sid="workbase2">
					<revolute sid="axis0">
						<axis>0 0 0</axis>
						<limits>
							<min>0</min>
							<max>0</max>
						</limits>
					</revolute>
				</joint>
				<joint name="workbase3" sid="workbase3">
					<revolute sid="axis0">
						<axis>0 0 0</axis>
						<limits>
							<min>0</min>
							<max>0</max>
						</limits>
					</revolute>
				</joint>
				<link sid="install_lid" name="install_lid">
					<attachment_full joint="kmodel0/workbase">
						<translate>-1.3 -0.9 -0.08</translate>
						<rotate>0 -0 -1 179.9995790817006</rotate>
						<link sid="workbase" name="workbase">
							<attachment_full joint="kmodel0/huatai">
								<translate>-0.03 0 0</translate>
								<rotate>1 0 0 0</rotate>
								<link sid="huatai" name="huatai">
									<attachment_full joint="kmodel0/qigang">
										<translate>-0.06 0.1695 -0.103</translate>
										<rotate>-3.673205103321794e-06 0.9999999999865076 -3.673205103321794e-06 179.9999999984539</rotate>
										<link sid="qigang" name="qigang">
											<attachment_full joint="kmodel0/install_j1">
												<translate>0 -0.25 0</translate>
												<rotate>0.5773495622796757 0.5773516830069292 0.5773495622796757 120.0002430171447</rotate>
												<link sid="install_j1" name="install_j1">
													<attachment_full joint="kmodel0/install_j2">
														<translate>-0.005 -0.005 -0.025</translate>
														<rotate>0 0 1 90.0002104591497</rotate>
														<link sid="install_j2" name="install_j2"/>
													</attachment_full>
													<attachment_full joint="kmodel0/install_j3">
