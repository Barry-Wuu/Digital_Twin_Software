        "平行传送装置-直道": {
            "icon": "平行直道.jpg",
            "geomRigid": [
                "()=>{",
                    "let a = 1.5/this.scale, A = 7.5/this.scale, shape = new THREE.Shape();",
                    "shape.lineTo(0, a);",
                    "shape.lineTo(A, a);",
                    "shape.lineTo(A, -a);",
                    "shape.lineTo(0, -a);",
                    "shape.closePath();", 
                    "return new THREE.ExtrudeGeometry(shape, {",  
                        "bevelEnabled: false,",  
                        "curveSegments: 5,",  
                        "depth: -0.6,",  
                        "steps: 1,",  
                    "})",
                "}"
            ],
            "material": { "color": "lightgray" },
            "modelPath": "stl/平行传送装置-直道.stl", 
            "rigid": true,
            "rigidShape": "geomRigid",
            "scale": 0.05,
            "v0": 1.5,
            "label": "conveyor",
            "layers": {
                "indicator": "[this.createArrow(0.5, 0, 0)]",
                "attachPoint1": "[this.createAttachPoint1(0, 0)]",
                "attachPoint2": "[this.createAttachPoint2(150, 0)]"
            }
        },
        "平行传送装置-顺时针弯道": {
            "icon": "平行弯道1.jpg",
            "material": { "color": "lightgray" },
            "modelPath": "stl/平行传送装置-弯道.stl", 
            "rigid": true,
            "scale": 0.05,
            "v0": 1.5,
            "label": "conveyor",
            "rigidShape": [
                "()=>{",
                    "const PI = Math.PI;",
                    "let r = 3.6/this.scale, R = 6.4/this.scale, shape = new THREE.Shape();",
                    "shape.moveTo(0, R);",
                    "shape.absarc(0, 0, R, PI/2, PI, false);",
                    "shape.absarc(0, 0, r, PI, PI/2, true);",
                    "shape.closePath();",  
                    "return new THREE.ExtrudeGeometry(shape, {",
                        "bevelEnabled: false,",
                        "curveSegments: 5,",
                        "depth: -12,",
                        "steps: 1,",
                    "})",
                "}"
            ],
            "layers": {
                "indicator": "[this.createArrow(-5, 0, 90)]",
                "attachPoint1": "[this.createAttachPoint1(-100, 0)]",
                "attachPoint2": "[this.createAttachPoint2(0, 100)]"
            }
            
